@page
@model AuditModel
@{
    ViewData["Title"] = "Журнал действий";
    ViewData["AdminTab"] = "audit";
}

<div class="page-head">
    <h1>Администрирование</h1>
</div>

<partial name="_AdminTabs" />

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-3">
        <label class="form-label small text-muted mb-0">Пользователь</label>
        <input type="search" name="Search" value="@Model.Search" class="form-control" placeholder="ФИО или логин" />
    </div>
    <div class="col-md-2">
        <label class="form-label small text-muted mb-0">Действие</label>
        <select name="ActionName" class="form-select">
            <option value="">Все</option>
            @foreach (var a in Model.Actions)
            {
                <option value="@a" selected="@(Model.ActionName == a)">@a</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small text-muted mb-0">Объект</label>
        <select name="EntityType" class="form-select">
            <option value="">Все</option>
            @foreach (var t in Model.EntityTypes)
            {
                <option value="@t" selected="@(Model.EntityType == t)">@AuditNames.EntityType(t)</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small text-muted mb-0">С даты</label>
        <input type="date" name="DateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label small text-muted mb-0">По дату</label>
        <input type="date" name="DateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-primary">Применить</button>
        <a class="btn btn-link" asp-page="./Audit">Сбросить</a>
    </div>
</form>

<div class="card shadow-sm">
    <table class="table table-hover table-list mb-0">
        <thead>
            <tr>
                <th><a asp-page="./Audit" asp-all-route-data='Model.SortLinkValues("at")'>Дата и время</a></th>
                <th><a asp-page="./Audit" asp-all-route-data='Model.SortLinkValues("user")'>Пользователь</a></th>
                <th><a asp-page="./Audit" asp-all-route-data='Model.SortLinkValues("action")'>Действие</a></th>
                <th><a asp-page="./Audit" asp-all-route-data='Model.SortLinkValues("entity")'>Объект</a></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Result.Items)
        {
            var url = Model.ObjectUrl(r);
            <tr>
                <td class="text-nowrap">@Fmt.DateTimeLocal(r.At)</td>
                <td>@r.UserName</td>
                <td>@r.Action</td>
                <td>
                    @AuditNames.EntityType(r.EntityType)
                    @if (url != null)
                    {
                        <a href="@url">№ @r.EntityId</a>
                    }
                    else
                    {
                        <span class="text-muted">№ @r.EntityId</span>
                    }
                </td>
            </tr>
        }
        @if (!Model.Result.Items.Any())
        {
            <tr><td colspan="4" class="text-center text-muted py-4">Записей не найдено</td></tr>
        }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">Всего записей: @Model.Result.TotalCount</div>
    <partial name="_Pager" model="(Model.Result.Page, Model.Result.TotalPages)" />
</div>
