@page "{id:int}"
@using TrainingRegistry.Infrastructure
@model TrainingRegistry.Pages.Groups.DocumentsModel
@{
    ViewData["Title"] = "Документы группы";
    var warnings = (TempData["Warnings"] as string)?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
}

<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <div class="text-muted">@Model.Item.Name</div>
    </div>
    <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@Model.Item.Id">К группе</a>
</div>

@if (warnings.Length > 0)
{
    <div class="alert alert-warning">
        <div class="fw-semibold">Обратите внимание:</div>
        <ul class="mb-0">
            @foreach (var w in warnings)
            {
                <li>@w</li>
            }
        </ul>
    </div>
}
@if (Model.Errors.Count > 0)
{
    <div class="alert alert-danger">
        <div class="fw-semibold">Документ не сформирован:</div>
        <ul class="mb-0">
            @foreach (var e in Model.Errors)
            {
                <li>@e</li>
            }
        </ul>
    </div>
}

<form method="post" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Документ</label>
                <select id="kindSelect" class="form-select" asp-items="Html.GetEnumSelectList<GeneratedDocKind>()" asp-for="Kind"></select>
            </div>

            <div class="col-md-2" data-kinds="EnrollmentOrder CompletionOrder OtherExpulsionOrder Protocol">
                <label class="form-label" id="numberLabel">Номер</label>
                <input name="Form.Number" value="@Model.Form.Number" class="form-control" maxlength="20" />
            </div>
            <div class="col-md-2">
                <label class="form-label" id="dateLabel">Дата</label>
                <input name="Form.Date" type="date" value="@Model.Form.Date?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>

            <div class="col-md-3" data-kinds="EnrollmentOrder CompletionOrder AttestationSheet">
                <label class="form-label">Академических часов</label>
                <input name="Form.Hours" value="@Model.Form.Hours" class="form-control" />
            </div>
            <div class="col-md-3" data-kinds="EnrollmentOrder CompletionOrder OtherExpulsionOrder AttestationSheet">
                <label class="form-label">Регистрационный номер группы</label>
                <input name="Form.RegistrationNumber" value="@Model.Form.RegistrationNumber" class="form-control" maxlength="50" />
            </div>
            <div class="col-md-6" data-kinds="EnrollmentOrder CompletionOrder">
                <label class="form-label">Куратор группы</label>
                <input name="Form.Curator" value="@Model.Form.Curator" class="form-control" maxlength="200" />
            </div>

            <div class="col-md-3" data-kinds="EnrollmentOrder">
                <label class="form-label">Начало обучения</label>
                <input name="Form.StartDate" type="date" value="@Model.Form.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3" data-kinds="EnrollmentOrder">
                <label class="form-label">Окончание обучения</label>
                <input name="Form.EndDate" type="date" value="@Model.Form.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>

            <div class="col-md-3" data-kinds="CompletionOrder">
                <label class="form-label">Дата итоговой аттестации</label>
                <input name="Form.AttestationDate" type="date" value="@Model.Form.AttestationDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3" data-kinds="CompletionOrder OtherExpulsionOrder">
                <label class="form-label">Дата отчисления</label>
                <input name="Form.ExpelDate" type="date" value="@Model.Form.ExpelDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-6" data-kinds="CompletionOrder">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="allMembers" name="Form.AllMembers" value="true" />
                    <label class="form-check-label" for="allMembers">Включить всех слушателей группы (по умолчанию — только со статусом «Прошел обучение»)</label>
                </div>
            </div>

            <div class="col-md-6" data-kinds="OtherExpulsionOrder">
                <label class="form-label">Кого отчисляют</label>
                <select name="Form.EnrollmentId" class="form-select">
                    <option value="">— выберите —</option>
                    @foreach (var m in Model.Members.Where(m => m.Status != EnrollmentStatus.Completed))
                    {
                        <option value="@m.EnrollmentId">@m.FullName @(m.Status == EnrollmentStatus.Expelled ? "(уже отчислен)" : "")</option>
                    }
                </select>
            </div>
            <div class="col-md-12" data-kinds="OtherExpulsionOrder">
                <label class="form-label">Причина отчисления</label>
                <input name="Form.Reason" value="@Model.Form.Reason" class="form-control" maxlength="500"
                       placeholder="Например: по личному заявлению; в связи с неявкой на занятия" />
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="markExpelled" name="Form.MarkExpelled" value="true" checked />
                    <input type="hidden" name="Form.MarkExpelled" value="false" />
                    <label class="form-check-label" for="markExpelled">Перевести слушателя в статус «Отчислен» и записать причину в карточку</label>
                </div>
            </div>

            <div class="col-md-3" data-kinds="Protocol">
                <label class="form-label">Номер приказа об отчислении</label>
                <input name="Form.OrderNumber" value="@Model.Form.OrderNumber" class="form-control" maxlength="20" />
            </div>
            <div class="col-md-3" data-kinds="Protocol">
                <label class="form-label">Дата приказа</label>
                <input name="Form.OrderDate" type="date" value="@Model.Form.OrderDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-6" data-kinds="Protocol">
                <label class="form-label">Секретарь комиссии</label>
                <input name="Form.Secretary" value="@Model.Form.Secretary" class="form-control" maxlength="200" />
            </div>
            <div class="col-12" data-kinds="Protocol">
                <label class="form-label">Члены комиссии (по одному в строке)</label>
                <textarea name="Form.Commission" rows="3" class="form-control">@Model.Form.Commission</textarea>
                <div class="form-text">В протокол попадут слушатели с положительным результатом аттестации (или без оценки). Состав комиссии запоминается в группе.</div>
            </div>
        </div>
        <div class="form-text mt-3">
            Поля, которые в системе не заполнены, остаются в документе пустыми (подчёркивание), их можно дописать вручную.
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <button type="submit" class="btn btn-primary">Сформировать</button>
        <a class="btn btn-outline-success" asp-page="./Documents" asp-page-handler="List" asp-route-id="@Model.Item.Id" asp-route-format="docx">Список слушателей (Word)</a>
        <a class="btn btn-outline-success" asp-page="./Documents" asp-page-handler="List" asp-route-id="@Model.Item.Id" asp-route-format="xlsx">Список слушателей (Excel)</a>
    </div>
</form>

<h2 class="h4 mb-3">Сформированные документы</h2>
<div class="card shadow-sm">
    <table class="table align-middle mb-0">
        <thead><tr><th>Документ</th><th>Номер</th><th>Дата</th><th>Сформирован</th><th>Кто</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in Model.History)
        {
            <tr>
                <td>@d.Kind.GetDisplayName()</td>
                <td>@(d.Number ?? "—")</td>
                <td>@Fmt.Date(d.DocDate)</td>
                <td>@Fmt.DateTimeLocal(d.CreatedAt)</td>
                <td>@(d.CreatedBy ?? "—")</td>
                <td class="text-end"><a asp-page="./DocumentFile" asp-route-id="@d.Id">Скачать</a></td>
            </tr>
        }
        @if (!Model.History.Any())
        {
            <tr><td colspan="6" class="text-center text-muted py-4">Документы по этой группе ещё не формировались</td></tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        (function () {
            var select = document.getElementById('kindSelect');
            var blocks = document.querySelectorAll('[data-kinds]');
            var names = ['EnrollmentOrder', 'CompletionOrder', 'OtherExpulsionOrder', 'AttestationSheet', 'Protocol'];
            function update() {
                var current = isNaN(select.value) ? select.value : names[parseInt(select.value, 10)];
                blocks.forEach(function (b) {
                    b.style.display = b.getAttribute('data-kinds').split(' ').indexOf(current) >= 0 ? '' : 'none';
                });
                document.getElementById('numberLabel').textContent = current === 'Protocol' ? 'Номер протокола' : 'Номер приказа';
                document.getElementById('dateLabel').textContent = current === 'Protocol' ? 'Дата заседания' : 'Дата документа';
            }
            select.addEventListener('change', update);
            update();
        })();
    </script>
}
