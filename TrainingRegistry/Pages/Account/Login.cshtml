@page
@model LoginModel
@{
    ViewData["Title"] = "Вход";
    Layout = "_AuthLayout";
}

<div class="card auth-card shadow-sm">
    <div class="card-body p-4">
        <h1 class="h4 mb-1">Учёт обучающихся</h1>
        <p class="text-muted mb-4">Войдите в систему</p>

        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger py-2" role="alert">
                    @ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage
                </div>
            }

            <div class="mb-3">
                <label asp-for="Input.Login" class="form-label"></label>
                <input asp-for="Input.Login" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Input.Login" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Войти</button>
        </form>
    </div>
</div>
